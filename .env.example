# =============================================================================
# TalentMatch environment variables. Copy to `.env` (repo root) and fill in.
# `.env` is git-ignored. NOTHING here except NEXT_PUBLIC_* is ever sent to a browser.
# =============================================================================

# --- Database (server-side only) ---------------------------------------------
# Direct Postgres connection used by the ingestion API, migrations, seed and benchmark.
# Supabase: Project Settings → Database → Connection string (URI). Use the
# "Session pooler" (port 5432) URI for long-running processes.
# Local stack (docker compose --profile local): postgres://postgres:postgres@localhost:54322/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
# disable | no-verify | verify. Default: disable for localhost, verify otherwise.
# For Supabase, either download the CA cert (Database settings → SSL) and set
# DATABASE_CA_CERT=/path/prod-ca-2021.crt with verify, or use no-verify.
DATABASE_SSL=
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
# Database URL the API uses *inside* docker compose (localhost there is the container).
# Leave unset for the local profile; set to your Supabase URI when using Supabase.
COMPOSE_DATABASE_URL=

# --- Supabase HTTP API (used by the Next.js server via supabase-js) ----------
# Supabase: Project Settings → API. Local stack: http://localhost:54321
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Public anon key. Safe to expose: RLS only lets it read `jobs`. (Currently unused by the
# UI, which reads through the server; kept for future client-side features.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Bypasses RLS. Only read in server-only modules (apps/web/src/lib/server/*).
SUPABASE_SERVICE_ROLE_KEY=
# Local stack only: HS256 secret PostgREST uses to verify the two keys above.
# Generate keys with: pnpm db:keys
LOCAL_JWT_SECRET=

# --- OpenAI (server-side only) -------------------------------------------------
OPENAI_API_KEY=
# Optional, for OpenAI-compatible proxies.
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-mini
# Optional: minimal | low | medium | high (reasoning models only).
OPENAI_REASONING_EFFORT=

# openai     -> text-embedding-3-small (real semantic embeddings; costs money)
# ollama     -> a local Ollama embedding model (real semantic embeddings; free, runs on your machine)
# local-hash -> deterministic offline hashing embedder (NOT semantic; for tests/offline demo)
# Every stored vector records its model; do not mix providers in one database.
EMBEDDINGS_PROVIDER=openai
# openai -> LLM explanations (structured JSON, zod-validated, cached)
# ollama -> the same pipeline against a local Ollama chat model
# rules  -> deterministic rule-based explanations (offline; labelled as such in the UI)
EXPLANATIONS_PROVIDER=openai

# --- Ollama (local, free; used when a provider above is "ollama") ------------
# Ollama's OpenAI-compatible endpoint. No API key needed (the SDK sends a dummy one).
# Only reachable from processes on the same machine/network: NOT from a Vercel deployment.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Any embedding model up to 1536 dims; shorter vectors are zero-padded (cosine unchanged).
# Pull first: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Pull first: ollama pull llama3.1:8b  (any chat model with JSON-schema structured output)
OLLAMA_CHAT_MODEL=llama3.1:8b

# --- Ingestion API (apps/api) ------------------------------------------------
PORT=4000
# Shared secret between the Next.js server and the API (x-api-key header).
# Required when NODE_ENV=production. Generate: openssl rand -hex 32
INGEST_API_KEY=
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_PER_MINUTE=60
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting).
TRUST_PROXY=0

# --- Next.js app (apps/web, server-side) --------------------------------------
# Where the Next.js server forwards uploads. Must be reachable FROM the Next.js server
# (on Vercel that means a public URL, not localhost).
INGEST_API_URL=http://localhost:4000
# Hybrid search defaults (RRF). Weight 0 disables a retriever.
SEARCH_KEYWORD_WEIGHT=1
SEARCH_SEMANTIC_WEIGHT=1
SEARCH_RRF_K=60
# How many top matches get an explanation on detail pages.
EXPLAIN_TOP_N=5
